generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  relationMode = "prisma"
}

model Attendance {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  date         DateTime
  clockInTime  DateTime
  clockOutTime DateTime?
  totalHours   Decimal? @db.Decimal(5, 2)
  status       String @default("PRESENT")

  @@index([employeeId])
}

model Employee {
  id           String    @id @default(uuid())
  department   String
  position     String
  startDate    DateTime
  salary       Decimal   @db.Decimal(10, 2)
  status       String    @default("ACTIVE")
  managerId    String? // References another Employee
  manager      Employee? @relation("Manager", fields: [managerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contractType String
  endDate      DateTime?
  staffId      String    @unique

  users        User[]
  leave        Leave[]
  atendance    Attendance[]
  subordinates Employee[]   @relation("Manager") // Employees managed by this employee

  @@index([managerId])
}

model Leave {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  leaveType    String
  startDate    DateTime
  endDate      DateTime
  reason       String
  leaveStatus  String
  approvedById String
  approvedBy   User?     @relation(fields: [approvedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([employeeId])
  @@index([approvedById])
}

model MFA {
  id         String   @id @default(uuid())
  mfaSecret  String?
  isVerified Boolean  @default(false)
  mfaType    String   @default("OTP")
  qrCodeUrl String?
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([userId])
}

model OTP {
  id        String   @id @default(uuid())
  otp       String
  type   String
  userId    String   @map("user_id")
  user      User     @relation(  fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

model Token {
  id        String   @id @default(uuid())
  token     String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tokenType String
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@unique([tokenType, userId])
}

model User {
  id         String   @id @default(uuid())
  firstName  String
  lastName   String
  email      String   @unique
  password   String
  role       String
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  MFA   MFA[]
  OTP   OTP[]
  Token Token[]
  Leave Leave[]

  @@index([employeeId])
}
