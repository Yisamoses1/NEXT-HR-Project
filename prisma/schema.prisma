// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider                       = "prisma-client-js"
  interactiveTransactionsTimeout = 10000 // Set timeout to 10 seconds
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id           String    @id @default(uuid())
  department   String
  position     String
  startDate    DateTime
  salary       Decimal   @db.Decimal(10, 2)
  status       String    @default("ACTIVE")
  managerId    String? // References another Employee
  manager      Employee? @relation("Manager", fields: [managerId], references: [id])
  contractType String
  endDate      DateTime?
  staffId      String    @unique

  users        User[]
  leave        Leave[]
  atendance    Attendance[]
  subordinates Employee[]   @relation("Manager") // Employees managed by this employee
}

model User {
  id         String   @id @default(uuid())
  firstName  String
  lastName   String
  email      String   @unique
  password   String
  role       String
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  MFA   MFA[]
  OTP   OTP[]
  Token Token[]
  Leave Leave[]
}

model MFA {
  id         String   @id @default(uuid())
  mfaSecret  String
  isVerified Boolean  @default(false)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
}

model OTP {
  id        String   @id @default(uuid())
  otp       String
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now())
  expiresAt DateTime
}

model Token {
  id        String   @id @default(uuid())
  token     String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tokenType String
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model Attendance {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  date         DateTime
  clockInTime  DateTime
  clockOutTime DateTime
  totalHours   Decimal
  status       String
}

model Leave {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  leaveType    String
  startDate    DateTime
  endDate      DateTime
  reason       DateTime
  leaveStatus  String
  approvedById String
  approvedBy   User     @relation(fields: [approvedById], references: [id])
}
