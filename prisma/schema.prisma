// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  interactiveTransactionsTimeout = 10000 // Set timeout to 10 seconds
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id           String     @id @default(uuid())
  department   String
  position     String
  startDate    DateTime
  salary       Decimal    @db.Decimal(10, 2)
  status       String     @default("ACTIVE")
  managerId    String?
  manager      Employee?  @relation("ManagerEmployees", fields: [managerId], references: [id])
  surbodinates Employee[] @relation("ManagerEmployees") // Employees managed by this employee
  contractType String
  endDate      DateTime?
  staffId      String     @unique

  users     User[]
  leave     Leave[]
  atendance Attendance[]
}

model User {
  id           String   @id @default(uuid())
  firstName    String
  email        String   @unique
  lastName     String
  password String
  role         String
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  otp   OTP[]
  mfa   MFA[]
  leave Leave[]
}

model MFA {
  id         String   @id @default(uuid())
  mfa_secret String
  isVerified Boolean  @default(false)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
}

model OTP {
  id        String   @id @default(uuid())
  otp       String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime
  expiresAt DateTime
}

model Token {
  id        String   @id @default(uuid())
  token     String
  tokenType String
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model Attendance {
  id             String   @id @default(uuid())
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id])
  date           DateTime
  clock_in_time  DateTime
  clock_out_time DateTime
  totalHours     Decimal
  status         String
}

model Leave {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  leaveType    String
  startDate    DateTime
  endDate      DateTime
  reason       DateTime
  leaveStatus  String
  approvedById String
  approvedy    User     @relation(fields: [approvedById], references: [id])
}
